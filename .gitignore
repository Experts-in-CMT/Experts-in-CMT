# --- WordPress wp-content GitIgnore (Experts in CMT / Kenny build) ---

# OS/editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/
*.code-workspace

# Ignore everything by default
*

# Ignore all theme folders (the whitelist below re-includes only the live theme)
themes/*

# Explicitly include only the live theme, MU plugins, and repo meta
!themes/
!themes/expertsincmt/
!themes/expertsincmt/**
!mu-plugins/
!mu-plugins/**
!.github/
!.github/**

# Ignore build/runtime junk inside themes
themes/*/node_modules/
themes/*/dist/
themes/*/vendor/
themes/*/.sass-cache/

# Ignore WordPress runtime directories
plugins/
uploads/
upgrade/
cache/
wflogs/
ai1wm-backups/

# Allow .gitkeep if you use them
!uploads/.gitkeep

# Whitelist ACF local JSON groups
!acf-json/
!acf-json/*.json
