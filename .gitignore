# --- WordPress wp-content GitIgnore (Experts in CMT / Kenny build) ---


# OS/editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/
*.code-workspace

# Ignore everything by default
*

# Ignore all other themes (put BEFORE the whitelist so it doesn't override)
themes/*
themes/cmtgenes/

# Explicitly include only our active theme and MU plugins
!themes/
!themes/twentytwentyfive/
!themes/twentytwentyfive/**
!mu-plugins/
!mu-plugins/**
!.github/
!.github/**

# Ignore runtime junk inside themes
themes/*/node_modules/
themes/*/dist/
themes/*/vendor/
themes/*/.sass-cache/

# Ignore WordPress runtime directories
plugins/
uploads/
upgrade/
cache/
wflogs/
ai1wm-backups/

# Allow .gitkeep if you use them
!uploads/.gitkeep

# Whitelist ACF local JSON groups
!acf-json/
!acf-json/*.json
/themes/twentytwentyfive/_to_delete/_sync_to_delete
/themes/twentytwentyfive/_to_delete/_sync_to_delete
/themes/twentytwentyfive/_to_delete
