# --- WordPress wp-content GitIgnore (CMTA / Kenny build) ---

# OS/editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/
*.code-workspace

# Ignore everything by default
*

# Include only our custom code directories
!themes/
!themes/**
!mu-plugins/
!mu-plugins/**

# Ignore runtime junk inside themes
themes/*/node_modules/
themes/*/dist/
themes/*/vendor/
themes/*/.sass-cache/

# Ignore WordPress runtime directories
plugins/
uploads/
upgrade/
cache/
wflogs/
ai1wm-backups/

# Allow .gitkeep if you use them
!uploads/.gitkeep
