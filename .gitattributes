* text=auto eol=lf

# Treat common assets as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text

# Fonts
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary

# Keep line-endings consistent for CSS/JS/PHP
*.php text eol=lf
*.css text eol=lf
*.js  text eol=lf
