{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"customTemplates": [
		{
			"name": "page-no-title",
			"postTypes": [
				"page"
			],
			"title": "Page No Title"
		}
	],
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#FFFFFF",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#111111",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#FFEE58",
					"name": "Accent 1",
					"slug": "accent-1"
				},
				{
					"color": "#F6CFF4",
					"name": "Accent 2",
					"slug": "accent-2"
				},
				{
					"color": "#503AA8",
					"name": "Accent 3",
					"slug": "accent-3"
				},
				{
					"color": "#686868",
					"name": "Accent 4",
					"slug": "accent-4"
				},
				{
					"color": "#FBFAF3",
					"name": "Accent 5",
					"slug": "accent-5"
				},
				{
					"color": "color-mix(in srgb, currentColor 20%, transparent)",
					"name": "Accent 6",
					"slug": "accent-6"
				}
			]
		},
		"layout": {
			"contentSize": "1000px",
			"wideSize": "1340px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Tiny",
					"size": "10px",
					"slug": "20"
				},
				{
					"name": "X-Small",
					"size": "20px",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "30px",
					"slug": "40"
				},
				{
					"name": "Regular",
					"size": "clamp(30px, 5vw, 50px)",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "clamp(30px, 7vw, 70px)",
					"slug": "60"
				},
				{
					"name": "X-Large",
					"size": "clamp(50px, 7vw, 90px)",
					"slug": "70"
				},
				{
					"name": "XX-Large",
					"size": "clamp(70px, 10vw, 140px)",
					"slug": "80"
				}
			],
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"src": [
								"file:./assets/fonts/manrope/Manrope-VariableFont_wght.woff2"
							]
						}
					],
					"fontFamily": "Manrope, sans-serif",
					"name": "Manrope",
					"slug": "manrope"
				},
				{
					"fontFace": [
						{
							"fontFamily": "\"Fira Code\"",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"src": [
								"file:./assets/fonts/fira-code/FiraCode-VariableFont_wght.woff2"
							]
						}
					],
					"fontFamily": "\"Fira Code\", monospace",
					"name": "Fira Code",
					"slug": "fira-code"
				}
			],
			"fontSizes": [
				{
					"fluid": false,
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"fluid": {
						"max": "1.125rem",
						"min": "1rem"
					},
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"max": "1.375rem",
						"min": "1.125rem"
					},
					"name": "Large",
					"size": "1.38rem",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "2rem",
						"min": "1.75rem"
					},
					"name": "Extra Large",
					"size": "1.75rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"max": "3rem",
						"min": "2.15rem"
					},
					"name": "Extra Extra Large",
					"size": "2.15rem",
					"slug": "xx-large"
				}
			],
			"writingMode": true
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"blocks": {
			"core/group": {
				"border": {
					"bottom": {
						"style": "none",
						"width": "0px"
					},
					"color": null,
					"left": {
						"style": "none",
						"width": "0px"
					},
					"radius": "6px",
					"right": {
						"style": "none",
						"width": "0px"
					},
					"style": null,
					"top": {
						"style": "none",
						"width": "0px"
					},
					"width": null
				},
				"dimensions": {
					"minHeight": "0px"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						}
					}
				},
				"shadow": "none",
				"spacing": {
					"blockGap": "0",
					"margin": {
						"bottom": "0",
						"top": "0"
					},
					"padding": {
						"bottom": "0",
						"top": "0"
					}
				}
			},
			"core/paragraph": {
				"typography": {
					"fontSize": "1rem",
					"fontStyle": "normal",
					"fontWeight": "400",
					"letterSpacing": "0.05em",
					"lineHeight": "1.8"
				},
				"variations": {
					"text-annotation": {
						"color": {
							"text": "#555555"
						}
					},
					"text-subtitle": {
						"typography": {
							"fontSize": "18px",
							"fontStyle": "normal",
							"fontWeight": "500"
						}
					}
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"css": "",
		"elements": {
			"h1": {
				"typography": {
					"fontSize": "2.25rem",
					"fontStyle": "normal",
					"fontWeight": "700",
					"letterSpacing": "-0.01em"
				}
			},
			"h2": {
				"typography": {
					"fontStyle": "normal",
					"fontWeight": "700",
					"letterSpacing": "0em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.5rem",
					"fontStyle": "normal",
					"fontWeight": "700",
					"letterSpacing": "0em"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.25rem",
					"fontStyle": "normal",
					"fontWeight": "500"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "1.13rem",
					"fontStyle": "normal",
					"fontWeight": "400"
				}
			},
			"h6": {
				"typography": {
					"fontStyle": "normal",
					"fontWeight": "500"
				}
			},
			"heading": {
				"typography": {
					"fontStyle": "normal",
					"fontWeight": "400"
				}
			}
		},
		"spacing": {
			"blockGap": "1.2rem",
			"padding": {
				"left": "var(--wp--preset--spacing--50)",
				"right": "var(--wp--preset--spacing--50)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)",
			"fontSize": "1rem",
			"fontStyle": "normal",
			"fontWeight": "400",
			"letterSpacing": "0px",
			"lineHeight": "1.4"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "header",
			"name": "vertical-header",
			"title": "Vertical site header"
		},
		{
			"area": "header",
			"name": "header-large-title",
			"title": "Header with large title"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		},
		{
			"area": "footer",
			"name": "footer-columns",
			"title": "Footer Columns"
		},
		{
			"area": "footer",
			"name": "footer-newsletter",
			"title": "Footer Newsletter"
		},
		{
			"area": "uncategorized",
			"name": "sidebar",
			"title": "Sidebar"
		}
	]
}